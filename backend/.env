# =============================================
# Email to SMS Converter - COMPLETE .env FILE
# =============================================

#MONGO_URI=mongodb://localhost:27017/email_to_sms

EMAIL_USER=*****************@gmail.com
EMAIL_PASSWORD=******************
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_CHECK_INTERVAL=60


# ---------- SMS CONFIGURATION (httpSMS) ----------

SMS_API_URL=https://api.httpsms.com/v1/messages/send
SMS_API_KEY=________________________________________________________________
SMS_FROM_PHONE=+91*********
SMS_TO_PHONE=+91**********


TWILIO_ACCOUNT_SID=______________________________________
TWILIO_AUTH_TOKEN=_____________________________________
TWILIO_PHONE_NUMBER=+91*********
ALERT_PHONE_NUMBER=+91**********
VOICE_RETRY_LIMIT=2
VOICE_COOLDOWN_SECONDS=300

# ---------- SAFE TESTING ----------
# When true, SMS/voice are SIMULATED and no real messages/calls are sent.
# Strongly recommended during development and demos.
NOTIFICATION_MOCK_MODE=false

PORT=5000
NODE_ENV=development



FILTER_KEYWORDS=urgent,assignment,important,deadline,exam,result
