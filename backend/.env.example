# =============================================
# Email to SMS Converter (MailSense AI) — .env.example
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# =============================================

# ---------- SERVER ----------
PORT=5000
NODE_ENV=development

# ---------- DATABASE ----------
MONGO_URI=mongodb://localhost:27017/email_to_sms

# ---------- EMAIL MONITORING (Gmail IMAP) ----------
# Use a Google App Password (not your normal password).
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_CHECK_INTERVAL=60

# ---------- AI CLASSIFICATION (Google Gemini, optional) ----------
# If unset, the keyword-based fallback classifier is used.
GEMINI_API_KEY=

# ---------- SMS CHANNEL (httpSMS gateway) ----------
SMS_API_URL=https://api.httpsms.com/v1/messages/send
SMS_API_KEY=your_httpsms_api_key
SMS_FROM_PHONE=+910000000000
SMS_TO_PHONE=+910000000000

# ---------- AI VOICE CALL CHANNEL (Twilio Voice) ----------
# Only required if you want real phone calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_PHONE_NUMBER=+910000000000
VOICE_RETRY_LIMIT=2
VOICE_COOLDOWN_SECONDS=300

# ---------- SAFE TESTING ----------
# When true, SMS/voice are SIMULATED and no real messages/calls are sent.
# Strongly recommended during development and demos.
NOTIFICATION_MOCK_MODE=false

# ---------- FILTER KEYWORDS (fallback classifier) ----------
FILTER_KEYWORDS=urgent,critical,important,deadline,exam,result
